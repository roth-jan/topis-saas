# Supabase (Cloud-Login + geteilte Layouts). Ohne diese Werte läuft TOPIS
# im reinen localStorage-Modus (kein Login, kein Cloud-Button).
# Echte Werte stehen lokal in .env.local (gitignored).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>
